{
  "name": "todo-app",
  "version": "1.0.0",
  "description": "Offline task list for Android. Tasks stay on the device — local-only storage, on-device voice quick-add, no network permission.",
  "keywords": [
    "todo",
    "tasks",
    "android",
    "capacitor",
    "offline-first",
    "privacy",
    "vosk",
    "speech-recognition",
    "local-notifications"
  ],
  "author": "san-j-kv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/san-j-kv/todo-app.git"
  },
  "bugs": {
    "url": "https://github.com/san-j-kv/todo-app/issues"
  },
  "homepage": "https://github.com/san-j-kv/todo-app#readme",
  "type": "commonjs",
  "scripts": {
    "postinstall": "patch-package",
    "test": "node tests/run.js",
    "test:android": "cd android && .\\gradlew.bat testPlainDebugUnitTest",
    "sync": "cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "build:android": "cap sync android && cd android && .\\gradlew.bat assembleVoiceDebug",
    "build:android:plain": "cap sync android && cd android && .\\gradlew.bat assemblePlainDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "8.2.1"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.1"
  }
}
